# Backend API origin: Vite dev proxy target and `devenv up` readiness check.
BACKEND_URL=http://10.8.5.100:3000

# Relative so the client is same-origin regardless of the host used to browse
# (localhost or LAN IP); the dev server proxies /api/v1 to BACKEND_URL.
PUBLIC_PANAHON_API=/api/v1
