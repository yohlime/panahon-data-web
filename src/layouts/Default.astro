---
import NavBar from '@/components/NavBar.vue'
import SideBar from '@/components/SideBar.vue'
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" sizes="192x192" href={`${import.meta.env.BASE_URL}mo-logo.png`} />
    <link rel="apple-touch-icon" href={`${import.meta.env.BASE_URL}mo-logo.png`} />

    <!-- Scripts -->
  </head>
  <body class="fixed inset-0 bg-gray-700/30">
    <div class="flex justify-center items-center">
      <div class="max-w-screen-2xl flex flex-col w-full select-none h-screen">
        <NavBar client:load />
        <div class="flex flex-1 min-h-0">
          <SideBar client:load path={Astro.url.pathname} />
          <div class="bg-gray-200 text-gray-800 flex-1 overflow-y-auto">
            <slot />
          </div>
        </div>
      </div>
    </div>
  </body>
</html>
