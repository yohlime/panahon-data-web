---
import DefaultLayout from '@/layouts/Default.astro'

import Guard from '@/components/auth/Guard.vue'
import Profile from '@/components/settings/Profile.vue'
import ApiKeysTable from '@/components/apiKeys/Table.vue'
---

<DefaultLayout>
  <div class="p-4 flex flex-col gap-6">
    <Guard client:load />
    <h1 class="text-2xl font-bold">Settings</h1>
    <Profile client:load />
    <section class="bg-white rounded-lg p-4 shadow-sm">
      <h2 class="text-lg font-semibold mb-3">API Keys</h2>
      <ApiKeysTable client:load />
    </section>
  </div>
</DefaultLayout>
